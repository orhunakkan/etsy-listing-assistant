# Copy to .env (git-ignored) and fill in. Never commit the real key.
TYPESAFE_API_KEY=
# Etsy app "listing-assistant": Apps You've Made → keystring and shared secret
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must match a callback URL registered on the Etsy app, character for character
ETSY_REDIRECT_URI=http://localhost:3003/oauth/redirect
